    "version": "0.2.0",
    "configurations": [




        
        
        {
    "name": "reloadable",
    "type": "dart",
    "request": "launch",
    "program": "lib/main.dart",
    "args": [
      "-d",
      "chrome",
      "--web-experimental-hot-reload",
    ]
  },
        {
            "name": "dashbord",
            "request": "launch",
            "type": "dart"
        },
        {
            "name": "dashbord (profile mode)",
            "request": "launch",
            "type": "dart",
            "flutterMode": "profile"
        },
        {
            "name": "dashbord (release mode)",
            "request": "launch",
            "type": "dart",
            "flutterMode": "release"
        }
    ]
}